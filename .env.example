# THE CRATE — frontend configuration
#
# Everything here is FRONTEND-SAFE: it is baked into the static build and
# visible to anyone who opens the site. That is by design — these values are
# publishable identifiers, not secrets. Access is protected by your Supabase
# login + Row Level Security, not by hiding these.
#
# Easiest path: you can skip this file entirely and paste the same values
# into the app's Settings page after deploying. This file only matters if
# you build the site yourself.

# Supabase → Project Settings → API → "Project URL"
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → "anon public" key (the publishable one)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Spotify → developer.spotify.com → your app → "Client ID"
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id

# ────────────────────────────────────────────────────────────
# NEVER put any of these anywhere in this repository:
#   - Supabase service_role key
#   - Spotify Client Secret
#   - any personal access token
# THE CRATE is built so it never needs them.
# ────────────────────────────────────────────────────────────
